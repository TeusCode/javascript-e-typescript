<%- include('./includes/head')%>
<%- include('./includes/navbar') %>

<div class="container">
    <div class="row">
        <div class="col-lg-2"></div>

        <div class="col-lg-8 my-3">
            <h1 class="display-2 text-center my-3">Login</h1>
            <p class="text-center lead">Faça cadastro ou login abaixo</p>
            <div class="row">
                <div class="col-lg">
                    <h4>Faça seu cadastro</h4>

                    <form action="/login/register" method="POST">
                        <input type="hidden" name="_csrf" value="<%= csrfToken%>"> <!--Token autenticador-->
                        <div class="mb-3">
                            <label>E-mail</label>
                            <input type="email" class="form-control" name="email">
                        </div>
                        <div class="mb-3">
                            <label>Senha</label>
                            <input type="password" class="form-control" name="password">
                        </div>
                        <button type="submit" class="btn btn-primary">Submit</button>
                    </form>
                    
                </div>
                <div class="col-lg">
                    <h4>Faça seu login</h4>

                    <form action="/login/login" method="POST">
                        <input type="hidden" name="_csrf" value="<%= csrfToken%>">   <!--Token autenticador-->
                        <div class="mb-3">
                            <label>E-mail</label>
                            <input type="email" class="form-control" name="email">
                        </div>
                        <div class="mb-3">
                            <label>Senha</label>
                            <input type="password" class="form-control" name="password">
                        </div>
                        <button type="submit" class="btn btn-primary">Submit</button>
                    </form>

                </div>
            </div>
        </div>

        <div class="col-lg-2"></div>
    </div>
</div>

<%- include('./includes/footer')%>