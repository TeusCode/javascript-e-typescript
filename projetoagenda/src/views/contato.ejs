<%- include('./includes/head')%>
    <%- include('./includes/navbar') %>

        <div class="container">
            <div class="row">
                <div class="col-lg-2"></div>

                <div class="col-lg-8 my-3">
                    <h1 class="display-2 text-center my-3">Contatos</h1>
                    <p class="text-center lead">Crie ou edite os seus contatos abaixo</p>

                    <%- include('./includes/messages') %>

                        <div class="row">
                            <div class="col-lg">
                                <h4>Adicione abaixo um novo contato a agenda</h4>

                                <!--Se o contato já estiver sido criado no banco de dados, a lógica, vai permitir que ele seja editado, e não salvo novamente, como um novo-->
                                
                                <%if(contato._id){%> <!--Se o contato existir, vou editar-->
                                <form action="/contato/edit/<%= contato._id %>" method="POST"> <!--Não pode fechar a tag no final da linha, se não o form não vai considerar os inputs dentro, (considere um fechamento de tag, para os dois caminhos)-->
                                <% }else{%> <!--Se o contato não existir, não vou editar-->
                                <form action="/contato/register" method="POST">
                                <%}%>    

                                    <input type="hidden" name="_csrf" value="<%= csrfToken%>"> <!--Token autenticador-->
                                    <div class="mb-3">
                                        <label>Nome</label>
                                        <input value="<%= contato.nome%>" type="text" class="form-control" name="nome">
                                    </div>
                                    <div class="mb-3">
                                        <label>Sobrenome</label>
                                        <input value="<%= contato.sobrenome%>" type="text" class="form-control" name="sobrenome">
                                    </div>
                                    <div class="mb-3">
                                        <label>Telefone</label>
                                        <input value="<%= contato.telefone%>" type="tel" class="form-control" name="telefone">
                                    </div>
                                    <div class="mb-3">
                                        <label>E-mail</label>
                                        <input value="<%= contato.email%>" type="email" class="form-control" name="email">
                                    </div>


                                    <button type="submit" class="btn btn-primary">Salvar</button>
                                </form>

                            </div>
                        </div>
                </div>

                <div class="col-lg-2"></div>
            </div>
        </div>

        <%- include('./includes/footer')%>